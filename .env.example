# Canonical site URL for metadata, sitemap, robots, and Open Graph.
# If this variable is unset, or points at a loopback host, the site uses
# https://srulikshvadron.com
NEXT_PUBLIC_SITE_URL=https://srulikshvadron.com

# Resend — same three variables as production.
# The owner notification sends when RESEND_API_KEY and CONTACT_TO_EMAIL are set.
# If CONTACT_FROM_EMAIL is unset, the sender stays onboarding@resend.dev.
# That sandbox sender can only deliver to the Resend account owner, so the
# visitor confirmation is sent only when CONTACT_FROM_EMAIL is set.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
