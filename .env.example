# Canonical site URL for metadata, sitemap, robots, and Open Graph.
# If this variable is unset, or points at a loopback host, the site uses
# https://israel-shvadron-site.vercel.app
# After sruliksolutions.com is connected, set:
# NEXT_PUBLIC_SITE_URL=https://sruliksolutions.com
NEXT_PUBLIC_SITE_URL=https://israel-shvadron-site.vercel.app

# Resend — contact form email delivery.
# TODO: set a real API key and the inbox that should receive form messages.
RESEND_API_KEY=
# TODO: inbox for contact-form messages.
CONTACT_TO_EMAIL=
# Verified sender in Resend. Optional until email delivery is configured.
CONTACT_FROM_EMAIL=
